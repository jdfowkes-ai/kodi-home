<?xml version="1.0" encoding="UTF-8"?>
<!-- Pre-widget-reset recovery release 0.5.66. -->
<addon id="plugin.video.kodihome"
       name="Kodi Home"
       version="0.5.70"
       provider-name="jdfowkes-ai">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="context_item.py" args="add_watchlist">
                <label>Add to Watchlist</label>
                <visible>[String.IsEqual(ListItem.dbtype,movie) | String.IsEqual(ListItem.dbtype,tvshow)]</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Manual Watchlist and NVIDIA Shield app groups</summary>
        <description lang="en_GB">Manually managed Watchlist, NVIDIA Shield app groups, Kodi Favourites widgets, per-app artwork, and configurable live feeds selected from Kodi video folders. Playback does not change Watchlist entries.</description>
        <platform>all</platform>
    </extension>
</addon>
